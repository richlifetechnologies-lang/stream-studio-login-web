# ─── Supabase (provided automatically in the Edge Runtime; set for local dev) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only, never in the client

# ─── Master AI keys (SECRET — set in Supabase dashboard → Edge Functions → Secrets) ──
FAL_KEY=your-fal-ai-key
ELEVENLABS_KEY=your-elevenlabs-key

# ─── Billing (merchant of record) ─────────────────────────────────────────────
BILLING_PROVIDER=lemonsqueezy          # or: paddle
BILLING_WEBHOOK_SECRET=your-webhook-signing-secret
# Map provider product/variant ids to plan ids, comma-separated:
PLAN_MAP=ls_variant_123=starter,ls_variant_456=pro,ls_variant_789=studio

# ─── Client (desktop app) build-time env ──────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_USE_GATEWAY=1                     # 0 = keep old BYO-key behaviour
