# ─── Supabase (provided automatically in the Edge Runtime; set for local dev) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only, never in the client

# ─── Master AI keys (OPTIONAL fallback) ───────────────────────────────────────
# You can now set the video (fal.ai) and voice (ElevenLabs) keys from the admin
# panel → "API Keys" tab (stored in the gateway_keys table, admin-only). These
# env secrets are only the FALLBACK used when no key pair is linked to a user and
# no default pair exists. Setting them here is the most secure option; setting
# them in the dashboard is the most convenient. Use whichever you prefer.
FAL_KEY=your-fal-ai-key
ELEVENLABS_KEY=your-elevenlabs-key

# ─── Access model ─────────────────────────────────────────────────────────────
# There is NO self-serve online billing. Users contact the administrator, who
# grants/edits subscriptions from the admin panel (billing_provider = 'manual').
# No billing secrets are required.

# ─── Client (desktop app) build-time env ──────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_USE_GATEWAY=1                     # 0 = keep old BYO-key behaviour
